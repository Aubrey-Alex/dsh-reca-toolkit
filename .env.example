# Copy this file to .env. The real .env is ignored by git.

# DeepSeek planner / segment planner (OpenAI-compatible endpoint)
RECA_PLANNER_API_KEY=
RECA_PLANNER_BASE_URL=https://api.deepseek.com/v1
RECA_PLANNER_MODEL=deepseek-chat
RECA_SP_MODEL=deepseek-chat
RECA_SP_API_KEY=
RECA_SP_BASE_URL=
RECA_SP_API_PATH=chat
RECA_SP_THINKING_BUDGET=8000
RECA_PLANNER_API_PATH=chat

# ReCA's existing image/video provider variables.
# Keep these empty until the provider credentials are supplied.
DASHSCOPE_API_KEY=
DASHSCOPE_API_KEYS=
OPENAI_API_KEY=
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
ZIPLAB_API_KEY=

# Vision auditor routing used by the existing ReCA validator.
RECA_SEGMENT_VALIDATOR_MODEL=
RECA_SEGMENT_VALIDATOR_FPS=8
RECA_SEGMENT_VALIDATOR_ON_ERROR=raise

# GPT internal Responses API for the visual validator.
RECA_GPT_API_KEY=
RECA_GPT_RESPONSES_URL=
RECA_GPT_MODEL=gpt-5.6-sol
RECA_GPT_SERVICE_TIER=fast
RECA_DISABLE_HTTP_PROXY=1

# Wan 3.0 (Alibaba Model Studio / DashScope async video API).
RECA_WAN30_API_KEY=
RECA_WAN30_BASE_URL=https://dashscope.aliyuncs.com/api/v1
RECA_WAN30_MODEL=wan3.0-video
RECA_WAN30_SUBMIT_PATH=/services/aigc/video-generation/video-synthesis
RECA_WAN30_STATUS_PATH=/tasks/{task_id}
RECA_WAN30_UPLOAD_PATH=/uploads
RECA_WAN30_STAGE_LOCAL_MEDIA=1
RECA_WAN30_RESOLUTION=720P
RECA_WAN30_RATIO=16:9
RECA_WAN30_PROMPT_EXTEND=false
RECA_WAN30_WATERMARK=false
RECA_WAN30_POLL_INTERVAL_S=5
RECA_WAN30_TASK_TIMEOUT_S=3600

# Local gateway
RECA_GATEWAY_HOST=127.0.0.1
RECA_GATEWAY_PORT=8787
RECA_DEMO_BACKEND=wan
RECA_DEMO_RESOLUTION=1280x720
# Wan runs use the existing DashScope image backend for anchor assets.
# Set this to gpt-image-2 when an OpenAI Images-compatible gateway is available.
RECA_IMAGE_BACKEND=wan2.7-image-pro
